# Read by ~/.claude/skills/release-gate and release-ship, sourced as shell.
#
# The version lives in one place a person edits: the README's `go install`
# line. A release is a tag installed with `go install`; no binaries are built.
VERSION_CMD="grep -oE 'cmd/ctchargen@v[0-9][^ ]*' README.md"
VERSION_FILES="README.md:grep"

# Outdated modules, counting only those the build and tests link. `go list -m
# -u all` also reports modules a dependency's go.mod merely names; go mod tidy
# drops any pin on those, so a warning about them could never clear.
DEPS_CMD='mods=$(go list -deps -test -f "{{with .Module}}{{if not .Main}}{{.Path}}{{end}}{{end}}" ./... | sort -u); [ -n "$mods" ] || exit 0; out=$(go list -m -u -f "{{if .Update}}{{.Path}} {{.Version}} -> {{.Update.Version}}{{end}}" $mods 2>&1) || exit 1; printf "%s\n" "$out" | grep -v "^$" || true'
