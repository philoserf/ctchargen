{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/philoserf/ctchargen/blob/main/docs/character.schema.json",
  "title": "ctchargen character record",
  "description": "Classic Traveller character (Books 1-3, © 1977 text). schema_version 2: tracks the shape of the records the engine writes. A constraint that only narrows the schema to what the engine already produced is a clarification; one that would invalidate a record the current engine writes is a bump. Version 2 added age_months, benefits, retirement_pay, and title (milestone 3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ruleset",
    "engine_version",
    "policy_version",
    "rng",
    "inputs",
    "errata",
    "name",
    "age",
    "age_months",
    "terms",
    "service",
    "drafted",
    "rank",
    "characteristics",
    "upp",
    "skills",
    "benefits",
    "retirement_pay",
    "events"
  ],
  "properties": {
    "schema_version": { "const": "2" },
    "ruleset": { "type": "string" },
    "engine_version": { "type": "string" },
    "policy_version": { "type": "string" },
    "rng": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "seed"],
      "properties": {
        "algorithm": { "type": "string" },
        "seed": { "type": "integer", "minimum": 0 }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auto", "name", "service"],
      "properties": {
        "auto": { "type": "boolean" },
        "name": { "type": "string" },
        "service": { "type": "string" }
      }
    },
    "errata": { "type": "array", "items": { "type": "string" } },
    "name": { "type": "string" },
    "age": { "type": "integer", "minimum": 18 },
    "age_months": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11,
      "description": "Months beyond age, accrued only by medical-crisis recovery (pp. 7-8)."
    },
    "terms": { "type": "integer", "minimum": 0 },
    "service": {
      "type": "string",
      "description": "Empty for a civilian who declined the draft (E001)."
    },
    "drafted": { "type": "boolean" },
    "rank": { "type": "integer", "minimum": 0, "maximum": 6 },
    "rank_title": { "type": "string" },
    "characteristics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strength",
        "dexterity",
        "endurance",
        "intelligence",
        "education",
        "social_standing"
      ],
      "properties": {
        "strength": { "$ref": "#/$defs/characteristic" },
        "dexterity": { "$ref": "#/$defs/characteristic" },
        "endurance": { "$ref": "#/$defs/characteristic" },
        "intelligence": { "$ref": "#/$defs/characteristic" },
        "education": { "$ref": "#/$defs/characteristic" },
        "social_standing": { "$ref": "#/$defs/characteristic" }
      }
    },
    "upp": { "type": "string", "pattern": "^[0-9A-F]{6}$" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "level"],
        "properties": {
          "name": { "type": "string" },
          "level": { "type": "integer", "minimum": 1 },
          "category": { "enum": ["blade", "gun"] }
        }
      }
    },
    "benefits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cash", "passages", "travellers_aid", "weapons"],
      "properties": {
        "cash": { "type": "integer", "minimum": 0 },
        "passages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["high", "middle", "low"],
          "properties": {
            "high": { "type": "integer", "minimum": 0 },
            "middle": { "type": "integer", "minimum": 0 },
            "low": { "type": "integer", "minimum": 0 }
          }
        },
        "travellers_aid": { "type": "boolean" },
        "weapons": { "type": "array", "items": { "type": "string" } },
        "ship": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class",
            "book2_page",
            "receipts",
            "age_years",
            "payment_years_remaining",
            "constructive_possession"
          ],
          "properties": {
            "class": { "type": "string" },
            "book2_page": { "type": "integer" },
            "receipts": { "type": "integer", "minimum": 1 },
            "age_years": { "type": "integer", "minimum": 0 },
            "payment_years_remaining": { "type": "integer", "minimum": 0 },
            "constructive_possession": { "type": "boolean" }
          }
        }
      }
    },
    "retirement_pay": {
      "type": "integer",
      "minimum": 0,
      "description": "CR per year (pp. 7, 21); 0 when not retired or not eligible."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "assumed"],
      "properties": {
        "title": { "type": "string" },
        "assumed": { "type": "boolean" }
      }
    },
    "death": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "cause"],
      "properties": {
        "term": { "type": "integer", "minimum": 1 },
        "cause": { "type": "string" }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seq", "kind", "step"],
        "properties": {
          "seq": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["step", "throw", "choice", "outcome"] },
          "step": { "type": "string" },
          "label": { "type": "string" },
          "dice": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1, "maximum": 6 }
          },
          "dms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "value"],
              "properties": {
                "source": { "type": "string" },
                "value": { "type": "integer" }
              }
            }
          },
          "target": { "type": "string" },
          "total": { "type": "integer" },
          "success": { "type": "boolean" },
          "by": { "enum": ["policy", "player"] },
          "options": { "type": "array", "items": { "type": "string" } },
          "picked": { "type": "string" },
          "text": { "type": "string" },
          "ref": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "$defs": {
    "characteristic": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15,
      "description": "Numeric value; 2-12 initially, 1-15 through play (p. 4)."
    }
  }
}
