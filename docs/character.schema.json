{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/philoserf/ctchargen/blob/main/docs/character.schema.json",
  "title": "ctchargen character record",
  "description": "Classic Traveller character (Books 1-3, © 1977 text). schema_version 1: tracks the shape of the records the engine writes. A constraint that only narrows the schema to what the engine already produced is a clarification; one that would invalidate a record the current engine writes is a bump.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ruleset",
    "engine_version",
    "policy_version",
    "rng",
    "inputs",
    "errata",
    "name",
    "age",
    "terms",
    "service",
    "drafted",
    "rank",
    "characteristics",
    "upp",
    "skills",
    "events"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "ruleset": { "type": "string" },
    "engine_version": { "type": "string" },
    "policy_version": { "type": "string" },
    "rng": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "seed"],
      "properties": {
        "algorithm": { "type": "string" },
        "seed": { "type": "integer", "minimum": 0 }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auto", "name", "service"],
      "properties": {
        "auto": { "type": "boolean" },
        "name": { "type": "string" },
        "service": { "type": "string" }
      }
    },
    "errata": { "type": "array", "items": { "type": "string" } },
    "name": { "type": "string" },
    "age": { "type": "integer", "minimum": 18 },
    "terms": { "type": "integer", "minimum": 0 },
    "service": {
      "type": "string",
      "description": "Empty for a civilian who declined the draft (E001)."
    },
    "drafted": { "type": "boolean" },
    "rank": { "type": "integer", "minimum": 0, "maximum": 6 },
    "rank_title": { "type": "string" },
    "characteristics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strength",
        "dexterity",
        "endurance",
        "intelligence",
        "education",
        "social_standing"
      ],
      "properties": {
        "strength": { "$ref": "#/$defs/characteristic" },
        "dexterity": { "$ref": "#/$defs/characteristic" },
        "endurance": { "$ref": "#/$defs/characteristic" },
        "intelligence": { "$ref": "#/$defs/characteristic" },
        "education": { "$ref": "#/$defs/characteristic" },
        "social_standing": { "$ref": "#/$defs/characteristic" }
      }
    },
    "upp": { "type": "string", "pattern": "^[0-9A-F]{6}$" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "level"],
        "properties": {
          "name": { "type": "string" },
          "level": { "type": "integer", "minimum": 1 },
          "category": { "enum": ["blade", "gun"] }
        }
      }
    },
    "death": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "cause"],
      "properties": {
        "term": { "type": "integer", "minimum": 1 },
        "cause": { "type": "string" }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seq", "kind", "step"],
        "properties": {
          "seq": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["step", "throw", "choice", "outcome"] },
          "step": { "type": "string" },
          "label": { "type": "string" },
          "dice": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1, "maximum": 6 }
          },
          "dms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "value"],
              "properties": {
                "source": { "type": "string" },
                "value": { "type": "integer" }
              }
            }
          },
          "target": { "type": "string" },
          "total": { "type": "integer" },
          "success": { "type": "boolean" },
          "by": { "enum": ["policy", "player"] },
          "options": { "type": "array", "items": { "type": "string" } },
          "picked": { "type": "string" },
          "text": { "type": "string" },
          "ref": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "$defs": {
    "characteristic": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15,
      "description": "Numeric value; 2-12 initially, 1-15 through play (p. 4)."
    }
  }
}
